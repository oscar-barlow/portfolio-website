{
  "name": "portfolio-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "esbuild": "node esbuild.config.js --minify",
    "esbuild-dev": "node esbuild.config.js --watch",
    "test": "vitest --watch",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "dev": "concurrently \"yarn esbuild-dev\" \"yarn test:watch\" --names \"build,test\" --prefix name"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.15.0",
    "satori": "^0.33.4",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-load-config": "^6.0.1",
    "postcss-preset-env": "^11.3.2",
    "read-cache": "^1.0.0",
    "spellchecker-cli": "^7.0.3",
    "vitest": "^4.1.11"
  }
}
